# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase (estado local del CLI, no del proyecto)
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# volcados de esquema en la raíz (se generan para armar la base de
# producción, no son parte del repo). Solo la raíz: las migraciones de
# supabase/migrations/ sí se versionan.
/*.sql
