# Copiar este archivo a .env.local (nunca commitear .env.local) y completar
# con los valores del proyecto de Supabase correspondiente (dev/staging/prod
# tienen proyectos de Supabase distintos).

# Panel del proyecto en Supabase → Project Settings → API.
# La clave "anon"/"publishable" es pública por diseño: la seguridad de los
# datos depende de las políticas de RLS en la base, no del secreto de esta
# clave. Aun así vive en variables de entorno (no hardcodeada) para poder
# apuntar a distintos proyectos de Supabase sin tocar código.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave "service_role" NUNCA va aquí con el prefijo NEXT_PUBLIC_ (eso la
# expondría al navegador). Si en una fase posterior hace falta desde una
# ruta de servidor (app/api/**), se agrega sin ese prefijo y solo se lee en
# código que corre en el servidor.
# SUPABASE_SERVICE_ROLE_KEY=
